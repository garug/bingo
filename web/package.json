		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/google.accounts": "^0.0.15",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.2.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.3",
